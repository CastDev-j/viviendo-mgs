---
import BackToTopAstroButton from "@/components/ui/BackToTopAstroButton.astro";
import Footer from "@/layouts/partials/Footer.astro";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/layouts/partials/Header";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonicalURL?: string;
}

const siteConfig = {
  title: "Viviendo Migransueño A.C.",
  tagline: "Cumpliendo Sueños de Niños con Cáncer en Celaya",
  baseURL: "https://viviendo-mi-gran-sueno.vercel.app",
  favicon: "/images/favicon.png",
  logo: "/images/logo.png",
  author: "Andrés Castillo",
  defaultImage: "/images/og-image.png",
  defaultDescription:
    "Viviendo Migransueño (Viviendo mi gran sueño) es una asociación civil sin fines de lucro que cumple los sueños de niños y niñas con cáncer de escasos recursos en Celaya, Guanajuato. Ofrecemos viajes, fiestas, encuentros con ídolos, juguetes y apoyo integral.",
  phone: "+52-461-116-9054",
  email: "viviendo.mgsueno@gmail.com",
  address: {
    street:
      "Calle Capiro #116, Fracc. Xochipilli, Colonia Laureles 1ra sección",
    city: "Celaya",
    state: "Guanajuato",
    postalCode: "38020",
    country: "México",
  },
  coordinates: {
    lat: "20.5351",
    lng: "-100.83131",
  },
  schedule: "Lunes a Domingo de 9:00 - 18:00 hrs",
  social: {
    facebook: "https://www.facebook.com/profile.php?id=100052241268987",
    instagram: "https://www.instagram.com/viviendo_migransueno/",
    youtube: "https://www.youtube.com/@viviendomigransueno1307",
    whatsapp: "https://wa.me/524611169054",
  },
};

const {
  title = siteConfig.title,
  description = siteConfig.defaultDescription,
  image = siteConfig.defaultImage,
  noindex = false,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const fullTitle =
  title === siteConfig.title
    ? `${title} - ${siteConfig.tagline}`
    : `${title} | ${siteConfig.title}`;
const fullImageURL = new URL(image, Astro.site).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Viviendo Migransueño A.C.",
  alternateName: [
    "Viviendo mi gran sueño",
    "Viviendo Migransueno",
    "Migransueño",
  ],
  url: siteConfig.baseURL,
  logo: new URL(siteConfig.logo, Astro.site).href,
  image: fullImageURL,
  description: siteConfig.defaultDescription,
  founder: {
    "@type": "Person",
    name: siteConfig.author,
  },
  foundingDate: "2020",
  slogan: siteConfig.tagline,
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.city,
    addressRegion: siteConfig.address.state,
    postalCode: siteConfig.address.postalCode,
    addressCountry: "MX",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: siteConfig.coordinates.lat,
    longitude: siteConfig.coordinates.lng,
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: siteConfig.phone,
      contactType: "customer service",
      email: siteConfig.email,
      areaServed: "MX",
      availableLanguage: ["Spanish", "es"],
    },
    {
      "@type": "ContactPoint",
      contactType: "donations",
      email: siteConfig.email,
      url: siteConfig.baseURL + "/donaciones",
    },
  ],
  openingHours: "Mo-Su 09:00-18:00",
  sameAs: [
    siteConfig.social.facebook,
    siteConfig.social.instagram,
    siteConfig.social.youtube,
    siteConfig.social.whatsapp,
  ],
  areaServed: {
    "@type": "Place",
    name: "Guanajuato, México",
  },
  seeks: {
    "@type": "Thing",
    name: "Apoyo para niños con cáncer",
  },
  knowsAbout: [
    "Cáncer infantil",
    "Apoyo a niños con cáncer",
    "Cumplimiento de sueños",
    "Organización sin fines de lucro",
    "ONG Celaya",
    "Apoyo social Guanajuato",
  ],
  nonprofitStatus: "NonprofitANBI",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.title,
  alternateName: "Viviendo mi gran sueño",
  url: siteConfig.baseURL,
  description: description,
  inLanguage: "es-MX",
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteConfig.baseURL}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: siteConfig.baseURL,
    },
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Preconnect para recursos externos críticos -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- DNS Prefetch para otros recursos -->
    <link rel="dns-prefetch" href="https://www.facebook.com" />
    <link rel="dns-prefetch" href="https://www.instagram.com" />
    <link rel="dns-prefetch" href="https://www.youtube.com" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />

    <!-- Palabras clave optimizadas para búsquedas específicas -->
    <meta
      name="keywords"
      content="viviendo mi gran sueño, viviendo migransueño, migransueño celaya, niños con cáncer celaya, apoyo niños cáncer guanajuato, fundación niños cáncer, ONG cáncer infantil, cumplir sueños niños, asociación civil celaya, donaciones niños cáncer, voluntariado celaya, ayuda niños cáncer, organización sin fines de lucro celaya, sueños infantiles, apoyo oncológico infantil, viviendo mi gran sueño AC"
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="shortcut icon" href={siteConfig.favicon} />
    <link rel="icon" type="image/png" sizes="32x32" href={siteConfig.favicon} />
    <link rel="apple-touch-icon" href={siteConfig.favicon} />

    <!-- Preload critical assets only on homepage -->
    {
      Astro.url.pathname === "/" && (
        <link
          rel="preload"
          href="/images/hero-bg.avif"
          as="image"
          type="image/avif"
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:image:alt" content={`Logo de ${siteConfig.title}`} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="es_MX" />
    <meta property="fb:app_id" content="TU_FB_APP_ID" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageURL} />
    <meta
      property="twitter:image:alt"
      content={`Logo de ${siteConfig.title}`}
    />

    <!-- Geo tags -->
    <meta name="geo.region" content="MX-GUA" />
    <meta
      name="geo.placename"
      content={`${siteConfig.address.city}, ${siteConfig.address.state}`}
    />
    <meta
      name="geo.position"
      content={`${siteConfig.coordinates.lat};${siteConfig.coordinates.lng}`}
    />
    <meta
      name="ICBM"
      content={`${siteConfig.coordinates.lat}, ${siteConfig.coordinates.lng}`}
    />

    <!-- Robots -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      !noindex && (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }
    <meta
      name="googlebot"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta name="bingbot" content="index, follow" />

    <!-- Theme -->
    <meta name="theme-color" content="#FF69B4" />
    <meta name="msapplication-TileColor" content="#FF69B4" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <!-- Verificación de motores de búsqueda (añade tus códigos) -->
    <!-- <meta name="google-site-verification" content="TU_CODIGO_AQUI" /> -->
    <!-- <meta name="msvalidate.01" content="TU_CODIGO_BING_AQUI" /> -->

    <!-- Structured Data - Non-blocking -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
      async
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
      async
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
      async
    />

    <!-- Alternate languages -->
    <link rel="alternate" hreflang="es-mx" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={siteConfig.baseURL} />

    <!-- Inline critical CSS to reduce render-blocking -->
    <style is:inline>
      body {
        max-width: 100vw;
        overflow-x: hidden;
      }
      *::-webkit-scrollbar {
        display: none;
      }
    </style>

    <ClientRouter />
  </head>
  <body class="flex flex-col items-center w-screen">
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded"
    >
      Saltar al contenido principal
    </a>

    <Header client:load />
    <main id="main-content" class="w-full flex flex-col items-center">
      <slot />
    </main>
    <BackToTopAstroButton />
    <Footer />

    <!-- Etiquetas adicionales de seguimiento pueden ir aquí -->
  </body>
</html>
