---
import { SocialLinks } from "@/components/ui/SocialLinks";
import { FaClock, FaPhoneAlt } from "react-icons/fa";
import { FaLocationDot } from "react-icons/fa6";
import { siteConfig } from "@/config";
---

<footer
  class="w-full bg-theme-light/30 pb-0 flex justify-center items-center"
  style="border-radius: 52% 47% 25% 25% / 4% 4% 0% 0%;"
>
  <div class="container px-4">
    <div
      class="flex flex-col items-center justify-center w-full py-16 md:py-24 border-b-2 mb-8 border-primary/20"
    >
      <a
        href="/"
        class="group flex items-center justify-center py-2 px-4 border-4 border-white bg-white rounded-full mb-8 transition-all duration-300 hover:scale-105"
      >
        <img
          src="/images/logo.png"
          alt="Viviendo Migransueño Logo"
          class="h-20 w-20 md:h-24 md:w-24 transition-transform duration-300 group-hover:scale-110"
        />
      </a>

      <h2
        class="text-center text-2xl md:text-3xl text-primary font-bold mb-6 tracking-wider"
      >
        VISÍTANOS
      </h2>

      <a
        href="/aviso-privacidad"
        class="text-center text-lg md:text-xl text-primary px-6 tracking-wide hover:underline decoration-2 underline-offset-4 transition-all duration-300 hover:text-primary/80"
      >
        AVISO DE PRIVACIDAD
      </a>
    </div>

    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <div class="lg:col-span-2">
          <div class="p-6 md:p-8">
            <h3
              class="text-primary font-bold text-xl md:text-2xl mb-6 text-center lg:text-left"
            >
              Oficina de Viviendo Migransueño
            </h3>

            <div class="space-y-6">
              <a
                href={siteConfig.address.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start gap-4 p-4 rounded-xl hover:bg-primary/5 transition-all duration-300"
              >
                <div
                  class="shrink-0 w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center group-hover:bg-primary group-hover:scale-110 transition-all duration-300"
                >
                  <FaLocationDot
                    className="text-primary text-xl group-hover:text-white transition-colors duration-300"
                  />
                </div>
                <div class="flex-1">
                  <p class="font-semibold text-neutral-800 mb-1">Dirección</p>
                  <p
                    class="text-neutral-600 text-sm md:text-base leading-relaxed"
                  >
                    {siteConfig.address.street}, {
                      siteConfig.address.neighborhood
                    },<br />
                    {siteConfig.address.colony}<br />
                    {siteConfig.address.postalCode}
                    {siteConfig.address.city}, {siteConfig.address.country}
                  </p>
                </div>
              </a>

              <a
                href={`tel:${siteConfig.contact.phone}`}
                class="group flex items-center gap-4 p-4 rounded-xl hover:bg-primary/5 transition-all duration-300"
              >
                <div
                  class="shrink-0 w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center group-hover:bg-primary group-hover:scale-110 transition-all duration-300"
                >
                  <FaPhoneAlt
                    className="text-primary text-xl group-hover:text-white transition-colors duration-300"
                  />
                </div>
                <div class="flex-1">
                  <p class="font-semibold text-neutral-800 mb-1">Teléfono</p>
                  <p class="text-neutral-600 text-lg">
                    {siteConfig.contact.phoneDisplay}
                  </p>
                </div>
              </a>

              <div class="flex items-center gap-4 p-4 rounded-xl bg-primary/5">
                <div
                  class="shrink-0 w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center"
                >
                  <FaClock className="text-primary text-xl" />
                </div>
                <div class="flex-1">
                  <p class="font-semibold text-neutral-800 mb-1">Horario</p>
                  <p class="text-neutral-600">
                    {siteConfig.businessHours.days}
                  </p>
                  <p class="text-neutral-600 font-medium">
                    {siteConfig.businessHours.hours}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-1">
          <div class="p-6 md:p-8 h-full">
            <h3
              class="text-primary font-bold text-xl md:text-2xl mb-4 text-center"
            >
              SÍGUENOS
            </h3>
            <p class="text-neutral-600 text-center mb-6 text-sm md:text-base">
              Mantente conectado con nosotros en nuestras redes sociales
            </p>

            <div class="flex justify-center items-center min-h-[100px]">
              <SocialLinks className="flex gap-4 justify-center" />
            </div>

            <div class="mt-6 pt-6 border-t border-primary/20">
              <p class="text-center text-sm text-neutral-500">
                Comparte tu experiencia con <span
                  class="font-semibold text-primary"
                  >{siteConfig.hashtags.main}</span
                >
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-primary/20 py-6">
        <div
          class="flex flex-col md:flex-row items-center justify-between gap-4"
        >
          <p class="text-sm text-neutral-600 text-center md:text-left">
            &copy; {new Date().getFullYear()}
            {siteConfig.name}.
          </p>
          <p class="text-sm text-neutral-500 text-center md:text-right">
            {siteConfig.developer.role}: <span
              class="font-semibold text-primary"
              >{siteConfig.developer.name}</span
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
