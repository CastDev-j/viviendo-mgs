---
import { FadeUpContainer } from "@/components/FadeUpContainer";
import { BiSolidParty } from "react-icons/bi";
import { GiClothes } from "react-icons/gi";
import { FaBus, FaStar } from "react-icons/fa";
import { MdSmartToy } from "react-icons/md";
import { FadeAnimation } from "@/components/FadeAnimation";
import Base from "@/layouts/Base.astro";
import { CarouselComponent } from "@/components/Carousel";
import Timeline from "@/components/Timeline.astro";
---

<Base>
  <div class="flex flex-col w-full gap-20">
    <section class="section pt-24">
      <div class="container">
        <div
          class="flex flex-col gap-8 w-full text-center mx-auto max-w-4xl px-6"
        >
          <h2 class="text-3xl font-semibold">
            <FadeUpContainer client:visible>
              <span class="text-primary">¿Quiénes </span>
              <span class="text-secondary">somos?</span>
            </FadeUpContainer>
          </h2>

          <div class="text-lg leading-relaxed">
            <FadeUpContainer client:visible>
              <p class="mb-4">
                <strong>Viviendo mi gran sueño A.C</strong> nació de nuestro interés
                en ayudar a las personas menores de edad, que padecen <strong
                  >Cáncer</strong
                >, donde su estado de salud es crítico. Nuestros objetivos e
                inspiración nos convierten en una asociación que nos
                enorgullece.
              </p>

              <p>
                Apoyamos a los <strong>niños y niñas</strong> que padecen <strong
                  >Cáncer</strong
                >, de escasos recursos a través de servicios gratuitos como:
              </p>
            </FadeUpContainer>
          </div>

          <div
            class="flex flex-wrap justify-center gap-3 sm:gap-6 mt-8 lg:grid lg:grid-cols-5"
          >
            <FadeAnimation client:visible>
              <div
                class="p-2 sm:p-6 bg-white rounded-lg lg:rounded-xl flex flex-col gap-3 justify-center items-center text-secondary min-h-36 lg:hover:scale-105 transition-transform duration-300"
              >
                <FaBus className="text-4xl lg:text-5xl" />
                <h3
                  class="text-lg lg:text-base font-semibold text-center min-w-36 lg:min-w-0"
                >
                  Viajes<br />Nacionales
                </h3>
              </div>
            </FadeAnimation>

            <FadeAnimation client:visible>
              <div
                class="p-2 sm:p-6 bg-white rounded-lg lg:rounded-xl flex flex-col gap-3 justify-center items-center text-primary min-h-36 lg:hover:scale-105 transition-transform duration-300"
              >
                <BiSolidParty className="text-4xl lg:text-5xl" />
                <h3
                  class="text-lg lg:text-base font-semibold text-center min-w-36 lg:min-w-0"
                >
                  Fiestas
                </h3>
              </div>
            </FadeAnimation>

            <FadeAnimation client:visible>
              <div
                class="p-2 sm:p-6 bg-white rounded-lg lg:rounded-xl flex flex-col gap-3 justify-center items-center text-secondary min-h-36 lg:hover:scale-105 transition-transform duration-300"
              >
                <FaStar className="text-4xl lg:text-5xl" />
                <h3
                  class="text-lg lg:text-base font-semibold text-center min-w-36 lg:min-w-0"
                >
                  Conocer a<br />Algún Ídolo
                </h3>
              </div>
            </FadeAnimation>

            <FadeAnimation client:visible>
              <div
                class="p-2 sm:p-6 bg-white rounded-lg lg:rounded-xl flex flex-col gap-3 justify-center items-center text-primary min-h-36 lg:hover:scale-105 transition-transform duration-300"
              >
                <MdSmartToy className="text-4xl lg:text-5xl" />
                <h3
                  class="text-lg lg:text-base font-semibold text-center min-w-36 lg:min-w-0"
                >
                  Juguetes<br />Anhelados
                </h3>
              </div>
            </FadeAnimation>

            <FadeAnimation client:visible>
              <div
                class="p-2 sm:p-6 bg-white rounded-lg lg:rounded-xl flex flex-col gap-3 justify-center items-center text-secondary min-h-36 lg:hover:scale-105 transition-transform duration-300"
              >
                <GiClothes className="text-4xl lg:text-5xl" />
                <h3
                  class="text-lg lg:text-base font-semibold text-center min-w-36 lg:min-w-0"
                >
                  Cambio de<br />Guardaropa
                </h3>
              </div>
            </FadeAnimation>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
          <div
            class="flex flex-col gap-6 text-center p-8 lg:p-10 bg-theme-light/40 rounded-2xl"
          >
            <h3 class="text-2xl font-semibold">
              <FadeUpContainer client:visible>
                <span class="text-primary">¿Cuál es Nuestra Misión?</span>
              </FadeUpContainer>
            </h3>

            <div class="text-base leading-relaxed">
              <FadeUpContainer client:visible>
                <p>
                  Nuestra misión es cumplir los sueños de los <strong
                    >niños y niñas</strong
                  >
                  que padecen <strong>Cáncer</strong>, de escasos recursos, a
                  través de servicios gratuitos como: <strong
                    >viajes nacionales</strong
                  >, <strong>fiestas</strong>,
                  <strong>conocer a algún ídolo</strong>, <strong
                    >juguetes anhelados</strong
                  >
                  y <strong>cambio de guardarropa</strong>.
                </p>
              </FadeUpContainer>
            </div>
          </div>

          <div
            class="flex flex-col gap-6 text-center p-8 lg:p-10 bg-[#e3f1fb] rounded-2xl"
          >
            <h3 class="text-2xl font-semibold">
              <FadeUpContainer client:visible>
                <span class="text-secondary">¿Cuál es Nuestra Visión?</span>
              </FadeUpContainer>
            </h3>

            <div class="text-base leading-relaxed">
              <FadeUpContainer client:visible>
                <p>
                  Ser la Asociación que cumpla con la mayoría de los <strong
                    >sueños</strong
                  >
                  de las personas que se encuentran en el proceso de esta <strong
                    >enfermedad</strong
                  >, logrando establecer más <strong>centros de atención</strong
                  > de la Asociación Viviendo mi gran sueño en el <strong
                    >Estado de Guanajuato</strong
                  >, así como en otros <strong
                    >estados de la República Mexicana</strong
                  >, y claro de ser posible, crecer a nivel de otros <strong
                    >países del mundo</strong
                  >.
                </p>
              </FadeUpContainer>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container px-6">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-center mb-12 text-3xl font-semibold">
            <FadeUpContainer client:visible>
              <span class="text-primary">Algunos de los </span>
              <span class="text-secondary">sueños que cumplimos</span>
            </FadeUpContainer>
          </h2>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div
              class="flex flex-col gap-8 text-center lg:text-left p-6 lg:p-8"
            >
              <h3 class="text-2xl font-semibold text-primary">
                <FadeUpContainer client:visible> Información </FadeUpContainer>
              </h3>

              <div class="text-base leading-relaxed space-y-4">
                <FadeUpContainer client:visible>
                  <p>
                    En esta pequeña galería de imágenes, podrás ver algunos de
                    los
                    <strong>sueños</strong> que hemos cumplido a lo largo de nuestra
                    trayectoria.
                  </p>

                  <p>
                    Todos estos <strong>sueños</strong> no serían posibles sin la
                    ayuda de nuestros <strong>donadores</strong> y <strong
                      >voluntarios</strong
                    >.
                  </p>

                  <p>
                    Puedes ver más de nuestros <strong>sueños cumplidos</strong>
                    en nuestras <strong>redes sociales</strong>.
                  </p>
                </FadeUpContainer>
              </div>

              <FadeUpContainer client:visible>
                <a
                  rel="noopener"
                  target="_blank"
                  class="inline-flex items-center justify-center px-8 py-4 font-semibold text-lg text-white bg-primary rounded-full transition-all duration-300 hover:scale-105 hover:bg-primary/90 focus:outline-none focus:ring-4 focus:ring-primary/30"
                  href="https://www.facebook.com/profile.php?id=100052241268987&sk=photos&locale=es_LA"
                >
                  Visita nuestro Facebook
                </a>
              </FadeUpContainer>
            </div>

            <div class="flex flex-col gap-6 sm:p-6 lg:p-8">
              <h3 class="text-2xl font-semibold text-secondary text-center">
                <FadeUpContainer client:visible> Galería </FadeUpContainer>
              </h3>

              <FadeUpContainer client:visible>
                <CarouselComponent client:load />
              </FadeUpContainer>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section pb-20">
      <div class="container px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-center mb-16 text-4xl font-bold">
            <FadeUpContainer client:visible>
              <span class="text-primary">Conoce Nuestra </span>
              <span class="text-secondary">Historia</span>
            </FadeUpContainer>
          </h2>

          <Timeline />
        </div>
      </div>
    </section>
  </div>
</Base>
