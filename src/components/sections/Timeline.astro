---
import { FaLightbulb, FaHeart, FaAward, FaHandsHelping } from "react-icons/fa";
import { GiPartyPopper } from "react-icons/gi";
import { FadeUpContainer } from "@/components/animations/FadeUpContainer";

interface Timeline {
  title: string;
  date: string;
  description: string;
  link?: {
    url: string;
    text: string;
  };
  icon: any;
}

const dates: Timeline[] = [
  {
    title: "Fundación de Viviendo mi Gran Sueño A.C",
    date: "2016",
    description:
      "Viviendo mi gran sueño A.C nació de nuestro interés en ayudar a las personas menores de edad que padecen Cáncer, donde su estado de salud es crítico. Nuestros objetivos e inspiración nos convierten en una asociación que nos enorgullece.",
    icon: FaLightbulb,
  },
  {
    title: "Primeros Sueños Cumplidos",
    date: "2016 - 2020",
    description:
      "Durante los primeros años comenzamos a cumplir los sueños de niños y niñas con cáncer en Celaya y sus alrededores. Organizamos fiestas, entregamos juguetes y realizamos nuestras primeras acciones para llevar alegría a quienes más lo necesitan.",
    icon: GiPartyPopper,
  },
  {
    title: "Cumpliendo el Sueño de Meli",
    date: "diciembre, 2020",
    description:
      "Organizamos una fiesta sorpresa para Melania, una joven diagnosticada con leucemia. Le entregamos muchos regalos, una recámara, un tocador, maquillaje y música de banda. Este evento marcó un momento especial para nuestra organización y reforzó nuestro compromiso.",
    icon: FaHeart,
  },
  {
    title: "Más de 100 Sueños Cumplidos",
    date: "2016 - 2023",
    description:
      "A lo largo de estos años, la asociación ha cumplido los sueños de más de 100 niños y niñas con enfermedades graves. Cada sueño cumplido representa esperanza, alegría y la demostración de que unidos podemos hacer la diferencia.",
    icon: FaAward,
  },
  {
    title: "Continuamos Cumpliendo Sueños",
    date: "2024 - Actualidad",
    description:
      "Seguimos trabajando día a día para cumplir los sueños de niños y niñas con cáncer. Con el apoyo de donadores y voluntarios, continuamos llevando viajes nacionales, fiestas, encuentros con ídolos, juguetes anhelados y cambio de guardaropa a quienes lo necesitan.",
    icon: FaHandsHelping,
    link: {
      url: "/contact",
      text: "Únete como voluntario",
    },
  },
];
---

<ol class="relative border-s border-gray-200">
  {
    dates.map((event, index) => (
      <li class="mb-10 ms-6">
        <span class="absolute flex items-center justify-center w-6 h-6 bg-theme-light/30 text-primary rounded-full -start-3 ring-8 ring-white">
          <event.icon class="w-2.5 h-2.5 text-primary-800" aria-hidden="true" />
        </span>
        <FadeUpContainer client:visible>
          <h3 class="flex items-center mb-1 text-lg font-semibold text-gray-900">
            {event.title}{" "}
            {index === dates.length - 1 && (
              <span class="bg-theme-light/30 text-primary text-primary-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded-sm ms-3">
                Última Actualización
              </span>
            )}
          </h3>
        </FadeUpContainer>
        <FadeUpContainer client:visible>
          <time class="block mb-2 text-sm font-normal leading-none text-gray-400">
            {event.date}
          </time>
        </FadeUpContainer>
        <FadeUpContainer client:visible>
          <p class="mb-4 text-base font-normal text-gray-500">
            {event.description}
          </p>
        </FadeUpContainer>
        {event.link && (
          <a
            href={event.link.url}
            class="inline-flex gap-2 items-center px-4 py-2 text-sm font-semibold text-primary bg-white border border-primary rounded-lg hover:border-secondary hover:text-secondary transition-colors duration-300"
          >
            {event.link.text}
          </a>
        )}
      </li>
    ))
  }
</ol>
